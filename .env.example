# IT Asset Management Platform - Environment Variables
#
# See https://docs.djangoproject.com/en/6.1/ref/settings/#databases
# See https://docs.djangoproject.com/en/6.1/topics/settings/#-environment-variables
#
# IMPORTANT: Never commit real credentials. This file is an example only.
# Copy to .env and fill in actual values for local development.

# Environment: use "production" to enable fail-fast secure configuration checks.
DJANGO_ENV=development

# Debug mode (must be False in production)
DEBUG=True

# Secret key (required in production; generate a long random value)
SECRET_KEY=

# Database (leave SQLite for local development; set a Neon PostgreSQL URL only after review)
DATABASE_URL=sqlite:///db.sqlite3

# Allowed hosts (required in production; comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS production settings. Keep HSTS at 0 until HTTPS is verified end-to-end.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
# Comma-separated HTTPS origins, for example https://app.example.com
CSRF_TRUSTED_ORIGINS=

# Password-reset email. Use a Gmail App Password in production.
PROIT_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=

# Admin URL path (keep secret-ish)
DJANGO_ADMIN_URL=admin/

# Google OAuth (leave blank to keep the provider unavailable locally).
# Google Cloud Console callback:
# http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
